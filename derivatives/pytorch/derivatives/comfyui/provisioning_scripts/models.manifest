hf:Comfy-Org/MiniMax-H3/vae/minimax_h3_video_vae_int8_convrot.safetensors                     vae/minimax_h3_video_vae_int8_convrot.safetensors   @h3
hf:Comfy-Org/MiniMax-H3/vae/minimax_h3_audio_vae_fp32.safetensors                             vae/minimax_h3_audio_vae_fp32.safetensors,vae/minimax/minimax_h3_audio_vae_fp32.safetensors   @h3
hf:Kijai/MiniMax-H3-TAE/vae_approx/taeh3.safetensors                                          vae_approx/taeh3.safetensors   @h3
