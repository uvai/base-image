function fmtLeft(hours){
  if(!isFinite(hours)) return '';
  const m = Math.floor(hours * 60);
  const d = Math.floor(m / 1440), h = Math.floor((m % 1440) / 60), mm = m % 60;
  return d > 0 ? `${d}d ${h}h` : (h > 0 ? `${h}h ${mm}m` : `${mm}m`);
}
function paintBill(){
  const el = document.getElementById('billline');
  const b = lastBill;
  if(!b) return;
  if(b.err){ el.textContent = 'balance: unavailable ('+b.err+')'; return; }
  const rate = b.dph_self || b.dph || 0;
  let s = `balance: $${b.credit.toFixed(2)}`;
  if(rate > 0){
    s += ` · $${rate.toFixed(3)}/hr · ~${fmtLeft(b.credit / rate)} left`;
    // boot cost: spent so far (container uptime) + projected to ready
    if(bootInfo.upSec > 0 && !bootInfo.ready){
      const spent = (bootInfo.upSec / 3600) * rate;
      const togo  = (bootInfo.etaMin / 60) * rate;
      s += ` ┃ boot: spent $${spent.toFixed(2)}`;
      s += bootInfo.stalled ? ' · <span style="color:#d29922">rate collapsed — host may be a dud</span>'
                            : ` · $${togo.toFixed(2)} to go`;
    } else if(bootInfo.upSec > 0 && bootInfo.ready){
      const spent = (bootInfo.upSec / 3600) * rate;
      s += ` ┃ boot cost $${spent.toFixed(2)}`;
    }
  } else {
    s += ' · no running instances billing';
  }
  el.innerHTML = s;
}
