let lastBill = null;
function renderDownloads(lines, xlines){
  const card = document.getElementById('dlcard');
  const bars = document.getElementById('dlbars');
  const sum  = document.getElementById('dlsummary');
  const files = new Map();   // name -> last-seen row (later lines win)
  let queued = null, summary = null;
  const rowRe = /^(\S+\.(?:safetensors|pt|ckpt|gguf))\s+(\d+(?:\.\d+)?)%\s+(\S+)\/(\S+)\s+(\S+\/s)\s+ETA\s+(\S+)/;
  // hf/tqdm progress from extra_models.log: "name:  45%|███| 9.5G/21.0G [01:12<01:29, 129MB/s]"
  const tqdmRe = /^(.+?):?\s+(\d+)%\|[^|]*\|\s*([\d.]+[kKMGT]?i?B?)\/([\d.]+[kKMGT]?i?B?)\s*\[[^\]<]*<([^,\]]+),\s*([^\]\s]+)/;
  for(const raw of (xlines||[])){
    const m = raw.trim().match(tqdmRe);
    if(m){
      let name = m[1].trim();
      if(name.length > 44) name = name.slice(0, 41) + '…';
      files.set(name, {pct: parseFloat(m[2]), cur: m[3], tot: m[4],
                       spd: m[6].endsWith('/s') ? m[6] : m[6] + '/s', eta: m[5].trim()});
    }
  }
  for(const raw of (lines||[])){
    const line = raw.trim();
    const m = line.match(rowRe);
    if(m){ files.set(m[1], {pct:parseFloat(m[2]), cur:m[3], tot:m[4], spd:m[5], eta:m[6]}); continue; }
    const q = line.match(/^QUEUED \((\d+)\): (.*)$/);
    if(q){ queued = q[2]; continue; }
    const s = line.match(/=== Downloads @ .* - (.*) ===/);
    if(s){ summary = s[1]; }
  }
  const active = [...files.entries()].filter(([,f]) => f.pct < 100);
  if(!active.length && !queued){ card.style.display = 'none'; return; }
  card.style.display = 'flex';
  const etaMin = e => { const p = e.split(':').map(Number);
    return p.length === 3 ? p[0]*60 + p[1] + p[2]/60 : p[0] + (p[1]||0)/60; };
  const fmtEta = e => { const m = etaMin(e);
    if(!isFinite(m) || m <= 0) return '…';
    if(m < 1) return '<1m';
    if(m < 60) return Math.round(m) + 'm';
    return Math.floor(m/60) + 'h ' + Math.round(m%60) + 'm'; };
  const live = active.filter(([,f]) => !(f.spd.startsWith('0.0') || f.spd.startsWith('0B')));
  const longest = live.length ? Math.max(...live.map(([,f]) => etaMin(f.eta))) : 0;
  const bits = [];
  bits.push(active.length + ' downloading');
  if(longest > 0) bits.push('longest ~' + fmtEta(String(Math.floor(longest)) + ':' + String(Math.round((longest%1)*60)).padStart(2,'0')));
  if(summary) bits.push(summary);
  sum.textContent = bits.join(' · ');
  let html = '';
  for(const [name, f] of active){
    const stalled = f.spd.startsWith('0.0') || f.spd.startsWith('0B');
    const meta = stalled
      ? `${f.cur}/${f.tot} · <span style="color:#d29922">stalled</span>`
      : `${f.cur}/${f.tot} · ${f.spd} · about ${fmtEta(f.eta)} left`;
    html += `<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;gap:8px;margin-bottom:3px">
        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${name}</span>
        <span class=dim style="flex:none">${f.pct.toFixed(1)}%</span></div>
      <div style="height:9px;background:#21262d;border-radius:5px;overflow:hidden">
        <div style="width:${Math.min(100,f.pct)}%;height:100%;border-radius:5px;
             background:${stalled ? '#6e4b00' : '#1f6feb'}"></div></div>
      <div class=dim style="font-size:11px;margin-top:2px">${meta}</div>
    </div>`;
  }
  if(queued) html += `<div class=dim style="font-size:11px">queued: ${queued}</div>`;
  if(bars.innerHTML !== html) bars.innerHTML = html;
  // feed the header's boot-cost estimate
  bootInfo.etaMin = longest;
  bootInfo.stalled = active.length > 0 && live.length === 0;
  bootInfo.ready = false;
  paintBill();
}
