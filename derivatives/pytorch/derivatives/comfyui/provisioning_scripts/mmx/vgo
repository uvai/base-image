let term = null, fitAddon = null, termWs = null;
function termStatus(s){ document.getElementById('termstat').textContent = s; }
function connectTerm(){
  if(!window.Terminal || !window.FitAddon){ termStatus('xterm.js failed to load (offline?)'); return; }
  if(!term){
    term = new Terminal({fontSize:12, fontFamily:'ui-monospace,Menlo,monospace',
      cursorBlink:true, scrollback:4000,
      theme:{background:'#0d1117', foreground:'#c9d1d9', cursor:'#58a6ff'}});
    fitAddon = new FitAddon.FitAddon();
    term.loadAddon(fitAddon);
    term.open(document.getElementById('termbd'));
    term.onData(d => { if(termWs && termWs.readyState === 1) termWs.send('i:'+d); });
    new ResizeObserver(() => {
      if(!fitAddon) return;
      try{ fitAddon.fit(); }catch(e){}
      if(termWs && termWs.readyState === 1) termWs.send('r:'+term.cols+','+term.rows);
    }).observe(document.getElementById('termbd'));
    document.getElementById('termbd').addEventListener('click', () => {
      if(!termWs || termWs.readyState > 1) connectTerm(); });
  }
  termStatus('connecting…');
  termWs = new WebSocket('ws://localhost:'+location.port+'/term');
  termWs.binaryType = 'arraybuffer';
  termWs.onopen = () => {
    termStatus('connected');
    try{ fitAddon.fit(); }catch(e){}
    termWs.send('r:'+term.cols+','+term.rows);
    term.focus();
  };
  termWs.onmessage = ev => term.write(new Uint8Array(ev.data));
  termWs.onclose = () => termStatus('disconnected — click to reconnect');
  termWs.onerror = () => termStatus('connection error — click to retry');
}
